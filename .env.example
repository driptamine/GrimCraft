# Production model hosting (Cloudflare R2). Baked into the bundle at build time;
# leave ENDPOINT empty for local models/ in dev. r2.dev public URLs and custom
# domains serve the bucket root, so R2_PUBLIC_PATH usually stays empty.
#   R2_ENDPOINT_URL=https://pub-abcdefgh.r2.dev npm run build
R2_ENDPOINT_URL=
R2_PUBLIC_PATH=
# Optional override when UI assets live outside the endpoint above
# (production defaults VITE_ASSET_BASE to R2_ENDPOINT_URL).
R2_ASSET_BASE=
# Real bucket name for uploads (scripts/upload-*-r2.sh), not used by the build.
R2_BUCKET_NAME=

# R2 bulk upload via S3-compatible API (dashboard caps at 100 files).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Netlify deployment from GitHub Actions / CLI.
# Fill locally or set as GitHub Actions secrets; never commit real values.
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
